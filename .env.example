AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_STREAM_RATE_LIMIT_MAX_REQUESTS=12
CHAT_STREAM_RATE_LIMIT_WINDOW_SECONDS=60
